DATABASE_URL=postgres://angabin:angabin@localhost:5432/angabin
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=angabin-teb-dev-secret-key-32chars-min!!
# SMS: log (dev stub, refused in production) | kavenegar (prod; needs SMS_API_KEY)
SMS_PROVIDER=log
# SMS_API_KEY=
# SMS_SENDER=
# AI diet generation (Vercel AI SDK; Gateway default, one key covers both paths)
AI_API_KEY=
AI_MODEL=openai/gpt-5.4
# Optional OpenAI-compatible endpoint (custom proxy / local model). When set,
# AI_API_KEY is sent to it and the provider prefix is stripped from AI_MODEL.
# AI_BASE_URL=
# Demo login (/api-test/login + signin page buttons): on in dev, in prod only when true.
# WARNING: true lets anyone mint patient AND admin sessions. Never on real-data prod.
# DEMO_LOGIN_ENABLED=true